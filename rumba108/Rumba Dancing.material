
material Clothes_MAT
{
	technique
	{
		pass 
		{
			ambient 0 0 0 1
			specular 0.5 0.5 0.5 1 36.9231

			texture_unit DiffuseMap
			{
				texture Boss_diffuse.png 10
			}

			texture_unit NormalMap
			{
				texture Boss_normal.png 10
				colour_op_ex source1 src_current src_current
				colour_op_multipass_fallback dest_colour zero
				alpha_op_ex source1 src_current src_current
			}

			texture_unit SpecularMap
			{
				texture Boss_specular.png 10
				colour_op_ex source1 src_current src_current
				colour_op_multipass_fallback dest_colour zero
				alpha_op_ex source1 src_current src_current
			}
		}

	}

}

