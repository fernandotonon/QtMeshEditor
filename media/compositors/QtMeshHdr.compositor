compositor QtMeshHdrPipeline
{
    technique
    {
        texture rtHdr target_width target_height PF_FLOAT16_RGBA depth_pool 0

        target rtHdr
        {
            input none
            material_scheme ShaderGeneratorDefaultScheme

            pass clear
            {
                buffers colour depth
            }

            pass render_scene
            {
            }
        }

        target_output
        {
            input none
            pass render_quad
            {
                input 0 rtHdr
                material QtMesh/HdrTonemapPass
            }
        }
    }
}
