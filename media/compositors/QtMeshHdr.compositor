compositor QtMeshHdrPipeline
{
    technique
    {
        texture rtHdr target_width target_height PF_FLOAT16_RGBA

        target rtHdr
        {
            pass render_scene
            {
            }
        }

        target_output
        {
            pass render_quad
            {
                input 0 rtHdr
                material QtMesh/HdrTonemapPass
            }
        }
    }
}
