{
  "id": "vr",
  "displayName": "VR (source validation)",
  "description": "Validation-only preset for VR source assets where stereo rendering and frame-time budgets demand lean geometry, materials, and textures. glTF/FBX preparation checks only — export via engine VR cook pipelines, not platform SDK mesh formats.",
  "rules": {
    "allowed_formats": ["fbx", "glb", "gltf", "obj"],
    "max_triangle_count": 70000,
    "max_triangles_per_mesh": 35000,
    "max_vertex_count": 70000,
    "max_bones": 96,
    "max_submesh_count": 12,
    "max_material_count": 12,
    "max_draw_calls": 20,
    "max_texture_dimension": 2048,
    "max_anim_keyframes": 25000,
    "max_anim_duration": 300,
    "redundant_keyframes_pct": 25,
    "max_acmr": 0.85,
    "detect_zero_weight_bones": true,
    "texture_not_power_of_two": true,
    "allowed_texture_formats": ["png", "jpg", "webp"],
    "require_uv_channels": 1
  },
  "metadata": {
    "inspect_textures": true,
    "category": "modern",
    "platform": "vr",
    "scope": "validation",
    "engineHints": ["unreal", "unity", "godot"],
    "todoRules": ["require_lod"]
  }
}
