
material Material
{
	technique
	{
		pass 
		{
			diffuse 0.8 0.8 0.8 1
			specular 0.8 0.8 0.8 1 25

			texture_unit diffuse_map
			{
				texture Base_color.png 11
			}

			texture_unit normal_map
			{
				texture normal.png 11
			}

			texture_unit metallic
			{
				texture metallic.png 11
				colour_op_ex add_signed src_texture src_current
				colour_op_multipass_fallback dest_colour zero
			}

			texture_unit roughness
			{
				texture roughness.png 11
				colour_op_ex modulate_x2 src_texture src_current
				colour_op_multipass_fallback dest_colour zero
			}

			texture_unit albedo
			{
				texture Base_color.png 11
				colour_op_ex modulate src_texture src_diffuse
				colour_op_multipass_fallback dest_colour zero
			}
		}

	}

}
