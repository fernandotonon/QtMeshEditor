
material Ch14_Body
{
	technique
	{
		pass 
		{
			diffuse 0.8 0.8 0.8 1
			specular 0.5 0.5 0.5 1 20

			texture_unit diffuse_map
			{
				texture Ch14_1001_Diffuse.png 12
				colour_op_ex modulate src_texture src_diffuse
				colour_op_multipass_fallback dest_colour zero
			}

			texture_unit roughness
			{
				texture Ch14_1001_Glossiness.png 12
				colour_op_ex modulate_x2 src_texture src_current
				colour_op_multipass_fallback dest_colour zero
			}

			texture_unit albedo
			{
				texture Ch14_1001_Diffuse.png 12
				colour_op_ex modulate src_texture src_diffuse
				colour_op_multipass_fallback dest_colour zero
			}

			texture_unit normal_map
			{
				texture Ch14_1001_Normal.png 12
				colour_op_ex source1 src_current src_current
				colour_op_multipass_fallback dest_colour zero
			}
		}

	}

}
