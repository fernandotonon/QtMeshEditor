# Unreal Engine project — keep only the text-based sources + bake
# artifacts checked in. Everything below is regenerated by the editor
# on first open (or by build_vat_demo.py).

Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vs/
*.VC.db
*.opensdf
*.opendb
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# .uasset / .umap files are PROJECT-SPECIFIC binaries that build_vat_demo.py
# generates the first time the user opens the project. They're not
# committed because they'd re-cook per UE version anyway.
Content/Rumba/*.uasset
Content/VATDemo/

# Python __pycache__
Content/Python/__pycache__/
Config/
