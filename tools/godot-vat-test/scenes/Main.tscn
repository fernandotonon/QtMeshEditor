[node name="LabelLeft" type="Label3D" parent="Ground/Skeletal"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.1, 0)
text = "Skeletal (live)"
font_size = 32
modulate = Color(0.45, 0.95, 0.45, 1)
billboard = 1
no_depth_test = true

[node name="VAT" type="MeshInstance3D" parent="Ground" node_paths=PackedStringArray()]
; 180° rotation around Y so the VAT mesh faces the camera the same
; way the SkeletalLoader-instanced glTF does. Godot's glTF importer
; auto-flips the imported scene to match Godot's `forward = -Z`
; convention (glTF authors with `forward = +Z`); we attach the
; mesh resource directly here so we have to apply that rotation
; ourselves. Without this the VAT character looks "backwards"
; relative to the live-skinned ground-truth on the left.
transform = Transform3D(-1, 0, -1.62921e-07, 0, 1, 0, 1.62921e-07, 0, -1, 0.9, 0, 0)
mesh = SubResource("BoxMesh_placeholder")
surface_material_override/0 = SubResource("Material_placeholder_right")
script = ExtResource("2_vatplayer")
bake_dir = "res://assets/Barril_01"
source_gltf = "res://assets/Barril_01/source.gltf"

[node name="LabelRight" type="Label3D" parent="Ground/VAT"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 2.1, 0)
text = "VAT (replay)"
font_size = 32
modulate = Color(0.55, 0.7, 1, 1)
billboard = 1
no_depth_test = true

